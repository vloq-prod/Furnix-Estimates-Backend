# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://furnix:furnix@localhost:5432/furnix_estimates?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-at-least-32-random-characters-000"
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET="replace-me-too-with-at-least-32-random-characters"
JWT_REFRESH_EXPIRES_IN=7d

# ── HTTP ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
APP_PUBLIC_URL=http://localhost:5173

# ── PDF ───────────────────────────────────────────────────────────────────
PDF_STORAGE_DIR=./storage/pdf
# Set only if you skipped Puppeteer's bundled Chromium download:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Seed (used by prisma/seed.ts only) ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@vloq.com
SEED_ADMIN_PASSWORD=Furnix@2026
